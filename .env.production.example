# Application display name.
APP_NAME=QuizVault
# Laravel environment; keep production on the server.
APP_ENV=production
# Leave empty; scripts/deploy.sh generates this on first deployment.
APP_KEY=
# Disable detailed error pages in production.
APP_DEBUG=false
# Public domain name without a scheme, for example quiz.example.com.
APP_DOMAIN=YOUR_DOMAIN_HERE
# Canonical HTTPS application URL.
APP_URL=https://YOUR_DOMAIN_HERE
# Google OAuth web-client ID.
GOOGLE_CLIENT_ID=
# Google OAuth web-client secret; never commit the real value.
GOOGLE_CLIENT_SECRET=
# Exact Google OAuth callback URL.
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN_HERE/auth/google/callback
# Laravel database driver.
DB_CONNECTION=pgsql
# Internal Docker Compose database service name.
DB_HOST=db
# PostgreSQL internal container port.
DB_PORT=5432
# PostgreSQL database name.
DB_DATABASE=quizapp
# PostgreSQL application username.
DB_USERNAME=quizapp
# Leave CHANGE_ME; scripts/deploy.sh generates a strong password on first deployment.
DB_PASSWORD=CHANGE_ME
# Store sessions in the persistent application storage volume.
SESSION_DRIVER=file
# Send session cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
# Log only warnings and more severe events.
LOG_LEVEL=warning
